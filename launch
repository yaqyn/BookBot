#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v python3 >/dev/null 2>&1; then
    printf '%s\n' 'Error: Python 3.10 or newer is required.' >&2
    exit 127
fi
if (( $# == 0 )); then
    set -- "$project_dir/books/frankenstein.txt"
fi
exec python3 "$project_dir/main.py" "$@"
